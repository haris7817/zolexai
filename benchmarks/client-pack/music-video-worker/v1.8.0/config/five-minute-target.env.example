# Five-minute target for one three-minute 4K music-video format.
# Replace the command with the existing warm backend renderer adapter.
ZOLEX_RENDER_BACKEND=command
ZOLEX_RENDER_COMMAND_JSON=["/srv/zolexai/bin/render-with-existing-backend","--request","{request_json}","--output","{output}"]

# Example: if the existing 15-minute benchmark used four simultaneous render
# lanes, the same workload needs about 12 equivalent lanes to target five minutes.
ZOLEX_BASELINE_AUDIO_SECONDS=180
ZOLEX_BASELINE_JOB_SECONDS=900
ZOLEX_BASELINE_RENDER_CONCURRENCY=4
ZOLEX_TARGET_JOB_SECONDS=300
ZOLEX_RENDER_CONCURRENCY=12
ZOLEX_ANCHOR_CONCURRENCY=8
ZOLEX_ENFORCE_LATENCY_CAPACITY=true

# Short scenes stay at the built-in LTX working size; only the assembled master
# is enlarged to 4K. Benchmark this finishing stage on the production GPU.
ZOLEX_UPSCALE_BACKEND=cuda
ZOLEX_UPSCALE_GPU_ID=0
ZOLEX_UPSCALE_TIMEOUT=1800
ZOLEX_UPSCALE_CQ=18

# Keep the current backend's proven quality settings. The worker sends the
# latency target and quality policy to every command-render request.
LTX_NUM_INFERENCE_STEPS=24

# Lyric transcription runs alongside spectral audio analysis.
ZOLEX_TRANSCRIPTION_BACKEND=faster_whisper
ZOLEX_TRANSCRIPTION_MODEL=large-v3
ZOLEX_TRANSCRIPTION_DEVICE=cuda
ZOLEX_TRANSCRIPTION_COMPUTE_TYPE=float16

# The included local vision analyzer runs before LTX and releases GPU memory.
# Pre-cache this model on every worker so download time is not part of a job.
ZOLEX_REFERENCE_VISION_BACKEND=qwen
ZOLEX_REFERENCE_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
ZOLEX_REFERENCE_VISION_DEVICE=cuda:0
ZOLEX_REFERENCE_VISION_LOCAL_FILES_ONLY=true
# A permanently warm vision service can replace the local analyzer at scale;
# this command takes priority when configured.
# ZOLEX_REFERENCE_ANALYZER_COMMAND_JSON=["/srv/zolexai/bin/analyze-reference-video","--request","{request_json}","--contact-sheet","{contact_sheet}","--output","{output}"]

# Web link input. Keep the fetcher warm/cached and include download time in the
# end-to-end benchmark. Add hosts only when the service is permitted to ingest them.
ZOLEX_REFERENCE_FETCH_BACKEND=yt_dlp
ZOLEX_REFERENCE_FETCH_PYTHON=/srv/zolexai/.venv/bin/python
ZOLEX_REFERENCE_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com
ZOLEX_REFERENCE_MAX_BYTES=1073741824
ZOLEX_REFERENCE_FETCH_TIMEOUT=1800
