# Core worker
ZOLEX_WORK_ROOT=/srv/zolexai/runs
ZOLEX_FPS=24
ZOLEX_MAX_SOURCE_SECONDS=300
ZOLEX_SHOT_TARGET_SECONDS=4.5
ZOLEX_SHOT_MIN_SECONDS=2.0
ZOLEX_SHOT_MAX_SECONDS=7.0
ZOLEX_MAX_ATTEMPTS=3
ZOLEX_COMMAND_TIMEOUT=7200
# Safe single-GPU default. For four GPU workers, set 4 and provide four IDs.
ZOLEX_RENDER_CONCURRENCY=1
ZOLEX_RENDER_GPU_IDS=
ZOLEX_ANCHOR_CONCURRENCY=4

# Five-minute processing target calibrated from the existing three-minute / 
# 15-minute backend benchmark. Set BASELINE_RENDER_CONCURRENCY to the number of
# render lanes used by that measured run. Three times that capacity is required
# if per-lane performance remains unchanged.
ZOLEX_TARGET_JOB_SECONDS=300
ZOLEX_BASELINE_JOB_SECONDS=900
ZOLEX_BASELINE_AUDIO_SECONDS=180
ZOLEX_BASELINE_RENDER_CONCURRENCY=1
# Set true only after the warm command renderer has the calculated capacity.
ZOLEX_ENFORCE_LATENCY_CAPACITY=false
FFMPEG=ffmpeg
FFPROBE=ffprobe

# Render scenes at 1280x704 landscape or 704x1280 portrait, assemble once,
# then create the 4K delivery with FFmpeg CUDA scaling + NVENC. The already
# encoded song is stream-copied during this stage and is not encoded again.
ZOLEX_UPSCALE_BACKEND=cuda
ZOLEX_UPSCALE_GPU_ID=0
ZOLEX_UPSCALE_TIMEOUT=1800
ZOLEX_UPSCALE_CQ=18
# Optional true AI super-resolution service instead of FFmpeg Lanczos:
# ZOLEX_UPSCALE_BACKEND=command
# ZOLEX_UPSCALE_COMMAND_JSON=["/srv/zolexai/bin/ai-upscale","--request","{request_json}","--output","{output}"]

# Automatic timestamped lyric transcription. This runs only when the prompt
# asks to follow the lyrics, when lyric_mode=always, or when lyrics are supplied.
ZOLEX_TRANSCRIPTION_BACKEND=faster_whisper
ZOLEX_TRANSCRIPTION_MODEL=large-v3
ZOLEX_TRANSCRIPTION_DEVICE=cuda
ZOLEX_TRANSCRIPTION_COMPUTE_TYPE=float16
ZOLEX_TRANSCRIPTION_BEAM_SIZE=5
ZOLEX_TRANSCRIPTION_TIMEOUT=1800
ZOLEX_TRANSCRIPTION_DOWNLOAD_ROOT=/models/faster-whisper
# Alternative existing transcription service:
# ZOLEX_TRANSCRIPTION_BACKEND=command
# ZOLEX_TRANSCRIPTION_COMMAND_JSON=["/srv/zolexai/bin/transcribe-lyrics","--request","{request_json}","--output","{output}"]

# Optional local-LLM creative director. The built-in lyric interpreter works
# without this hook; configure it for deeper metaphor and narrative decisions.
# ZOLEX_LYRIC_DIRECTOR_COMMAND_JSON=["/srv/zolexai/bin/direct-lyrics","--request","{request_json}","--output","{output}"]

# Reference-video style analysis. Built-in metrics measure cuts, pacing, motion,
# brightness, contrast and color. The included Qwen2.5-VL analyzer reads the
# generated contact sheet and identifies shot scales, supported camera angles,
# scene archetypes, lighting and composition. It unloads before LTX rendering.
ZOLEX_REFERENCE_SAMPLE_FRAMES=12
ZOLEX_REFERENCE_MAX_SECONDS=600
ZOLEX_REFERENCE_SCENE_THRESHOLD=0.32
ZOLEX_REFERENCE_ANALYSIS_TIMEOUT=900
# Use a cached Hugging Face model ID or an absolute local model directory.
ZOLEX_REFERENCE_VISION_BACKEND=qwen
ZOLEX_REFERENCE_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
ZOLEX_REFERENCE_VISION_DEVICE=cuda:0
ZOLEX_REFERENCE_VISION_MAX_NEW_TOKENS=768
ZOLEX_REFERENCE_VISION_MIN_PIXELS=200704
ZOLEX_REFERENCE_VISION_MAX_PIXELS=1003520
# Change to true after pre-caching the model on every production worker.
ZOLEX_REFERENCE_VISION_LOCAL_FILES_ONLY=false
# This existing-service hook takes priority over the in-process Qwen analyzer.
# ZOLEX_REFERENCE_ANALYZER_COMMAND_JSON=["/srv/zolexai/bin/analyze-reference-video","--request","{request_json}","--contact-sheet","{contact_sheet}","--output","{output}"]

# Web-page reference-link input. The built-in downloader uses yt-dlp from the
# reference-links package extra. Only HTTPS URLs on these approved domains are
# accepted; subdomains are allowed. Playlists and IP-address URLs are blocked.
ZOLEX_REFERENCE_FETCH_BACKEND=yt_dlp
ZOLEX_REFERENCE_FETCH_PYTHON=/srv/zolexai/.venv/bin/python
ZOLEX_REFERENCE_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com
ZOLEX_REFERENCE_MAX_BYTES=1073741824
ZOLEX_REFERENCE_FETCH_TIMEOUT=1800
# Alternative existing download service:
# ZOLEX_REFERENCE_FETCH_BACKEND=command
# ZOLEX_REFERENCE_FETCH_COMMAND_JSON=["/srv/zolexai/bin/fetch-reference","--request","{request_json}","--output","{output}"]

# Production anchor-image generator. The executable must read request_json and
# create the exact PNG path supplied in output.
ZOLEX_ANCHOR_BACKEND=command
ZOLEX_ANCHOR_COMMAND_JSON=["/srv/zolexai/bin/generate-anchor","--request","{request_json}","--output","{output}"]

# Official LTX-2.5 two-stage audio-to-video pipeline.
# The included `zolex-music-video install-models --models-root /models` command
# downloads, verifies, and writes these model paths to /models/zolex-models.env.
ZOLEX_RENDER_BACKEND=ltx
LTX_PYTHON=/srv/ltx/.venv/bin/python
LTX_MODULE=ltx_pipelines.a2vid_two_stage
LTX_TRANSFORMER_PATH=/models/ltx-2.5/diffusion_models/ltx-2.5-22b-dev-transformer-bf16.safetensors
LTX_TEXT_ENCODER_PATH=/models/ltx-2.5/text_encoders/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
LTX_VIDEO_VAE_PATH=/models/ltx-2.5/vae/ltx-2.5-video-vae-bf16.safetensors
LTX_AUDIO_VAE_PATH=/models/ltx-2.5/vae/ltx-2.5-audio-vae-bf16.safetensors
LTX_SPATIAL_UPSAMPLER_PATH=/models/ltx-2.5/latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors
LTX_DISTILLED_LORA_PATH=/models/ltx-2.5/loras/ltx-2.5-22b-distilled-lora-450-bf16.safetensors
LTX_DISTILLED_LORA_STRENGTH=1.0
LTX_NUM_INFERENCE_STEPS=24
# Optional official runtime flags. FP8-cast reduces memory use on supported CUDA hosts.
# LTX_EXTRA_ARGS_JSON=["--quantization","fp8-cast"]

# Optional production-only quality and lip-sync hooks.
# ZOLEX_QA_COMMAND_JSON=["/srv/zolexai/bin/qa-shot","--clip","{clip}","--shot","{shot_json}","--report","{report}"]
# ZOLEX_LIPSYNC_COMMAND_JSON=["/srv/zolexai/bin/lipsync-shot","--request","{request_json}","--output","{output}"]

# Alternative renderer contract, useful when LTX already lives behind another service.
# ZOLEX_RENDER_BACKEND=command
# ZOLEX_RENDER_COMMAND_JSON=["/srv/zolexai/bin/render-shot","--request","{request_json}","--output","{output}"]
