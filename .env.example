# ZolexAI — environment template
#
# Copy to `.env` at the repo root:   cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file documents every
# variable and contains NO real secrets (security baseline §17, §21).
#
# ONE file serves all three services:
#   apps/api      reads it directly (pydantic-settings)
#   apps/worker   reads it directly (pydantic-settings)
#   apps/web      next.config.ts loads it so NEXT_PUBLIC_* reaches the bundle
#   docker compose --env-file .env … uses it for port mappings and credentials

# ── App ──────────────────────────────────────────────────────────────────
# development | staging | production. Production refuses to boot without a
# strong WORKER_API_TOKEN and real storage credentials.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8100

# ── Logging ──────────────────────────────────────────────────────────────
# json for aggregators, console for humans.
LOG_FORMAT=console
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=zolexai
POSTGRES_USER=zolexai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://zolexai:change-me@localhost:5432/zolexai

# ── Redis ────────────────────────────────────────────────────────────────
# Coordination and cache only — never a source of truth (ADR 0004).
# Windows note: if Docker cannot bind 6379, the port likely falls in a
# reserved range; check `netsh interface ipv4 show excludedportrange
# protocol=tcp` and pick a free one (e.g. 6479).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO locally; S3/R2-compatible in production) ───────
STORAGE_PROVIDER=minio
# Endpoint the API itself talks to. Inside Docker: http://minio:9000
STORAGE_ENDPOINT=http://localhost:9000
# Endpoint that goes into presigned URLs handed to a BROWSER. Differs from
# STORAGE_ENDPOINT whenever the API runs in Docker and the browser does not —
# the host is part of the signature and cannot be rewritten afterwards.
# Empty = same as STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=zolexai-dev
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=zolexai_dev
STORAGE_SECRET_KEY=change-me
STORAGE_PRESIGN_EXPIRY_SECONDS=900
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Worker coordination ──────────────────────────────────────────────────
# Service credential for /api/v1/internal/* — a dedicated secret, never a
# user login. Production requires ≥ 32 characters; the API refuses to start
# otherwise.
WORKER_API_TOKEN=dev_worker_token_change_me_0123456789
WORKER_NAME=mock-worker-1
API_BASE_URL=http://localhost:8100
# How long a claim is valid before the reaper may hand the job to another
# worker, and how many attempts before a job fails for good (no infinite
# retries — directive §23).
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3

# ── Generation runtimes (GPU nodes only) ─────────────────────────────────
# Unset everywhere else. A node without these runs the mock runtime and can
# only claim mock-routed workflows, so leaving them blank is safe rather than
# broken.
#
# Video (LTX-2.5). RUNTIMES is what lets a node claim GPU-routed work at all;
# the rest have working defaults in apps/worker/worker/core/config.py.
# RUNTIMES=ltx
# LTX_REPO_DIR=/workspace/ltx2-benchmark
# LTX_MAX_SECONDS=60      # measured single-pass ceiling (post-NATTEN, 16 Aug 2026) — longer is segmented; code default is 60
#
# Music (ACE-Step 1.5 XL). Unlike LTX, the model is NOT launched per job — it
# is a long-lived service holding ~24 GB that answers requests in seconds, so
# the worker connects to it the way it would to a database. Start the service
# separately, then point the worker at it.
#
# NOTE: music (~24 GB) and video (~28 GB peak) cannot both be resident on a
# 32 GB card. One GPU serves one workload at a time; running both concurrently
# needs a second GPU.
# RUNTIMES=music              # or "ltx,music" once the queue serialises them
# MUSIC_PROVIDER=acestep
# ACESTEP_BASE_URL=http://127.0.0.1:8001
# ACESTEP_API_KEY=            # only if the service was started with one
# ACESTEP_MAX_SECONDS=600     # measured single-generation ceiling
# MUSIC_SECONDS_PER_LINE=6    # lyric density (re-measured on acestep-v15-xl-turbo, 21 Aug 2026); see worker/music/lyrics.py

# Automatic lyrics. When a customer leaves the lyrics box empty and the track
# is not an instrumental, these decide who writes the words. ACE-Step still
# does all the singing — the writer below only produces text.
#
# The order is the fallback order, and a fallback is only used for a language
# it can actually write: "template" is an English-only bank, so with no
# Cerebras key a Spanish request is refused rather than answered in English.
# Leaving CEREBRAS_API_KEY unset is safe — the chain simply behaves as it did
# when "template" was the only writer.
# MUSIC_LYRICS_WRITER=cerebras,template
#
# WORKER/SERVER ONLY. Never sent to the browser, never put in job parameters,
# never logged. The web app has no notion of a lyrics provider at all.
# CEREBRAS_API_KEY=
# CEREBRAS_LYRICS_MODEL=gemma-4-31b   # multilingual; see worker/music/cerebras.py
# CEREBRAS_LYRICS_ENABLED=true        # feature switch, independent of the key
# CEREBRAS_LYRICS_TIMEOUT_SECONDS=45
# CEREBRAS_LYRICS_MAX_RETRIES=1       # covers BOTH transport and wrong-language retries

# ── Fair use (foundation; per-plan limits arrive with M3 billing) ────────
DEFAULT_USER_CONCURRENCY_LIMIT=3

# ── HTTP ─────────────────────────────────────────────────────────────────
# Comma-separated explicit origins. A wildcard is rejected at startup.
CORS_ORIGINS=http://localhost:3000
API_PORT=8100
WEB_PORT=3000

# ── Frontend ─────────────────────────────────────────────────────────────
# INLINED INTO THE BROWSER BUNDLE AT BUILD TIME — rebuild after changing.
# Empty = same origin (the correct production default behind one domain).
NEXT_PUBLIC_API_URL=http://localhost:8100

# ── M3 placeholders (unused in M1; documented so the shape is agreed) ────
SESSION_SECRET=
BILLING_PROVIDER=mock
BILLING_SECRET=
BILLING_WEBHOOK_SECRET=
