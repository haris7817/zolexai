# ZolexAI — environment template
#
# This file documents variables and contains NO real secrets (architecture doc §36).
# Copy to `.env` locally. `.env` is gitignored and must never be committed.
#
# ─────────────────────────────────────────────────────────────────────────────
# PRE-M1 (current phase) — the UI/UX demo needs NONE of the values below.
# `apps/web` runs entirely on mock data with no backend. Everything here is
# documented ahead of Milestone 1 so the shape is agreed before implementation.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Everything below is M1+ and unused during the PRE-M1 demo ---

# Database (M1.11)
POSTGRES_DB=zolexai
POSTGRES_USER=zolexai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://zolexai:change-me@localhost:5432/zolexai

# Redis (M1.12)
REDIS_URL=redis://localhost:6379/0

# Object storage (M1.13) — MinIO locally, S3/R2-compatible in production
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=zolexai-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Auth (M3.01) — server-managed sessions, HttpOnly cookies
SESSION_SECRET=

# Worker (M1.19) — dedicated service credential, never an admin login
WORKER_API_TOKEN=

# Billing (M3.11) — provider still undecided (decision register D-05)
BILLING_PROVIDER=mock
BILLING_SECRET=
BILLING_WEBHOOK_SECRET=
